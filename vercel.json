{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build_site.js",
  "installCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/pages/projects.html"
    },
    {
      "source": "/journal",
      "destination": "/pages/journal.html"
    },
    {
      "source": "/shelf",
      "destination": "/pages/shelf.html"
    },
    {
      "source": "/about",
      "destination": "/pages/about.html"
    },
    {
      "source": "/shelf/games",
      "destination": "/pages/shelf/games.html"
    },
    {
      "source": "/projects/website",
      "destination": "/pages/projects/website.html"
    },
    {
      "source": "/projects/glass",
      "destination": "/pages/projects/glass.html"
    },
    {
      "source": "/shelf/death-stranding",
      "destination": "/pages/shelf/death-stranding.html"
    },
    {
      "source": "/shelf/cyberpunk",
      "destination": "/pages/shelf/cyberpunk.html"
    }
  ],
  "redirects": [
    {
      "source": "/pages/:path(.*)\\.html",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/library",
      "destination": "/shelf",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/notes",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/lab",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
